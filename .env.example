# Copy to backend/.env for local use. Local mode binds only to 127.0.0.1.
PORT=3001
# Relative to backend/, regardless of command working directory. Absolute paths also work.
DATABASE_PATH=./data/expense-tracker.sqlite
# Startup and db:init apply pending migrations and insert missing catalog entries.
# Existing records are never reset. Back up an existing database before schema changes.
# Vite uses fixed local port 5173 and proxies /api to 127.0.0.1:3001.
# If PORT changes, update frontend/vite.config.ts to match.
# Never put secrets in VITE_* variables; those are exposed to the browser.

# Explicit public-demo preparation. Leave both flags false for local development.
PUBLIC_DEMO_MODE=false
HOSTED_DEPLOYMENT=false
# Required only when PUBLIC_DEMO_MODE=true; examples, not deployed services:
# PUBLIC_DEMO_ORIGIN=https://expense-tracker.example-account.workers.dev
# PUBLIC_DEMO_HOST=expense-tracker-lpkl.onrender.com
# Public mode ignores DATABASE_PATH and creates query-only in-memory SQLite.
# Frontend build settings belong in frontend/.env.local or Cloudflare Workers build variables:
# VITE_PUBLIC_DEMO_MODE=true
# VITE_API_BASE_URL=https://expense-tracker-lpkl.onrender.com
