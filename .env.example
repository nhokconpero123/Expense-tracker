# Copy to backend/.env. The backend always binds to 127.0.0.1.
PORT=3001
# Relative to backend/, regardless of command working directory. Absolute paths also work.
DATABASE_PATH=./data/expense-tracker.sqlite
# Startup and db:init apply pending migrations and insert missing catalog entries.
# Existing records are never reset. Back up an existing database before schema changes.
# Vite uses fixed local port 5173 and proxies /api to 127.0.0.1:3001.
# If PORT changes, update frontend/vite.config.ts to match.
# Never put secrets in VITE_* variables; those are exposed to the browser.
